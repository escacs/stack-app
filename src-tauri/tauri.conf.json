{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stack",
  "version": "0.1.6",
  "identifier": "codes.escacs.stack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Stack",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/escacs/stack-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBRUREMkVDNjI4QTdFNEYKUldSUGZvcGk3Tkx0T2xOSS9HRHpLbjZQa0wrQmRVVGVDbitQSVhZWjZZT1M2VGo2T01zRjRZaWEK"
    }
  }
}
