{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stack",
  "version": "0.2.0",
  "identifier": "codes.escacs.stack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Stack",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Browse the stack catalog and keep imported skills, styles and components up to date",
    "longDescription": "Stack is a desktop client for the escacs stack: browse the catalog of agent assets, import entries with an Import plan, keep imports healthy in your project (updates, edits, missing files) and send entries to T3 Code threads.",
    "publisher": "escacs",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/escacs/stack-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBRUREMkVDNjI4QTdFNEYKUldSUGZvcGk3Tkx0T2xOSS9HRHpLbjZQa0wrQmRVVGVDbitQSVhZWjZZT1M2VGo2T01zRjRZaWEK"
    }
  }
}
