{
  "name": "@escacs/stack-app",
  "version": "0.1.4",
  "private": true,
  "description": "escacs stack desktop client (Tauri 2 + SolidJS + Vite). Works against an escacs/stack checkout.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:ui": "vitest run --environment node",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.12.0",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-solid": "2.11.15",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
